# Токен сообщества: Управление → Работа с API → Ключи доступа.
# Права: «Управление сообществом» и «Сообщения сообщества».
VK_TOKEN=

# Числовой id сообщества без минуса.
VK_GROUP_ID=

# DEBUG — чтобы видеть каждое событие, INFO — только важное.
LOG_LEVEL=INFO

# Django: локально можно не заполнять — включится режим разработки.
# На сервере задать свой ключ и DJANGO_DEBUG=0.
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=1
